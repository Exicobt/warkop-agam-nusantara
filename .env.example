# ── Database (MySQL) ───────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/NAMA_DATABASE"

# ── Sesi login ─────────────────────────────────────────────────
# Wajib minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# URL publik aplikasi (dipakai untuk membuat link QR meja)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Zona waktu untuk jam di notifikasi (opsional, default Asia/Jakarta)
# APP_TIMEZONE="Asia/Jakarta"

# ── Firebase (web, publik) — Firebase Console > Project settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Firebase Admin (RAHASIA) — Project settings > Service accounts
# Salin nilai dari file JSON service account. private_key ditulis satu baris
# dengan "\n" literal, diapit tanda kutip.
FB_PROJECT_ID=""
FB_CLIENT_EMAIL=""
FB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
